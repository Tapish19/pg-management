# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Razorpay (get test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Optional real WhatsApp test (server-only; never use a VITE_ prefix)
# Sends hello_world/en_US only, to the verified recipient configured here.
WHATSAPP_DEMO_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEST_RECIPIENT=
# At least 12 characters; enter privately in Settings > Notifications.
WHATSAPP_DEMO_PASSCODE=
